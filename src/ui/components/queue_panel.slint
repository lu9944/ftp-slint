import { Button, ListView } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export struct TaskRow {
    task-id: int,
    name: string,
    direction: string,
    size-str: string,
    progress: float,
    progress-str: string,
    speed-str: string,
    status: string,
}

export component QueuePanel inherits Rectangle {
    in-out property <[TaskRow]> tasks;
    in-out property <int> selected: -1;
    callback cancel-task(int);
    callback clear-finished();
    height: 170px;

    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 6px;
    clip: true;

    VerticalLayout {
        padding: 6px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "传输队列";
                font-size: 12px;
                color: Theme.fg-dim;
                vertical-alignment: center;
            }
            Rectangle { }
            Text {
                text: "并发: 2    限速: 关";
                font-size: 11px;
                color: Theme.fg-dim;
                vertical-alignment: center;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: transparent;
            Text {
                text: "暂无传输任务（双击远程文件下载 / 双击本地文件上传）";
                font-size: 12px;
                color: Theme.fg-dim;
                visible: root.tasks.length == 0;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            ListView {
                visible: root.tasks.length > 0;
                for task[i] in root.tasks: Rectangle {
                    height: 26px;
                    background: root.selected == task.task-id ? Theme.pressed : (ta.has-hover ? Theme.hover : transparent);
                    ta := TouchArea {
                        clicked => {
                            root.selected = task.task-id;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Text {
                            text: task.direction;
                            width: 46px;
                            font-size: 12px;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }
                        Text {
                            text: task.name;
                            horizontal-stretch: 1;
                            font-size: 12px;
                            color: Theme.fg;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        Text {
                            text: task.size-str;
                            width: 80px;
                            font-size: 12px;
                            color: Theme.fg-dim;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            bar-holder := Rectangle {
                                width: 140px;
                                height: 8px;
                                background: Theme.bg;
                                border-radius: 4px;
                                clip: true;
                                Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: bar-holder.width * task.progress;
                                    height: bar-holder.height;
                                    background: Theme.accent;
                                    border-radius: 4px;
                                }
                            }
                        }
                        Text {
                            text: task.progress-str;
                            width: 56px;
                            font-size: 12px;
                            color: Theme.fg-dim;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        Text {
                            text: task.speed-str;
                            width: 92px;
                            font-size: 12px;
                            color: Theme.fg-dim;
                            vertical-alignment: center;
                        }
                        Text {
                            text: task.status;
                            width: 56px;
                            font-size: 12px;
                            color: task.status == "已完成" ? Theme.ok : (task.status == "失败" ? #f28b82 : Theme.fg-dim);
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 6px;
            Button {
                text: "开始";
                enabled: false;
            }
            Button {
                text: "暂停";
                enabled: false;
            }
            Button {
                text: "取消";
                enabled: root.selected >= 0;
                clicked => {
                    root.cancel-task(root.selected);
                }
            }
            Button {
                text: "清已完成";
                clicked => {
                    root.clear-finished();
                }
            }
            Rectangle { }
        }
    }
}
