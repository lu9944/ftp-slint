import { Button, LineEdit } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component Toolbar inherits Rectangle {
    in-out property <string> host;
    in-out property <string> port;
    in-out property <string> username;
    in-out property <string> password;
    in property <bool> connected;
    callback connect-clicked;
    callback disconnect-clicked;
    callback test-clicked;

    height: 44px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 6px;

    HorizontalLayout {
        padding: 6px;
        spacing: 6px;

        Text {
            text: "主机";
            font-size: 12px;
            color: Theme.fg-dim;
            vertical-alignment: center;
        }
        LineEdit {
            text <=> root.host;
            placeholder-text: "example.com";
            horizontal-stretch: 2;
        }
        Text {
            text: "端口";
            font-size: 12px;
            color: Theme.fg-dim;
            vertical-alignment: center;
        }
        LineEdit {
            text <=> root.port;
            width: 64px;
            placeholder-text: "21";
        }
        Text {
            text: "用户";
            font-size: 12px;
            color: Theme.fg-dim;
            vertical-alignment: center;
        }
        LineEdit {
            text <=> root.username;
            horizontal-stretch: 1;
            placeholder-text: "anonymous";
        }
        Text {
            text: "密码";
            font-size: 12px;
            color: Theme.fg-dim;
            vertical-alignment: center;
        }
        LineEdit {
            text <=> root.password;
            input-type: InputType.password;
            horizontal-stretch: 1;
        }
        Button {
            text: root.connected ? "断开" : "快速连接";
            clicked => {
                if (root.connected) {
                    root.disconnect-clicked();
                } else {
                    root.connect-clicked();
                }
            }
        }
        Button {
            text: "测试";
            clicked => {
                root.test-clicked();
            }
        }
    }
}
