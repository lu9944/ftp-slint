import { ListView, LineEdit, Button } from "std-widgets.slint";
import { Theme } from "../theme.slint";

component IconButton inherits Rectangle {
    in property <string> icon;
    callback clicked;
    width: 28px;
    min-height: 24px;
    border-radius: 4px;
    background: ta.pressed ? Theme.pressed : (ta.has-hover ? Theme.hover : transparent);
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    Text {
        text: root.icon;
        font-size: 14px;
        color: ta.has-hover ? Theme.fg : Theme.fg-dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component MenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;
    height: 26px;
    background: mi-ta.pressed ? Theme.pressed : (mi-ta.has-hover ? Theme.hover : transparent);
    opacity: root.enabled ? 1.0 : 0.35;
    mi-ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    Text {
        text: root.label;
        font-size: 12px;
        color: Theme.fg;
        vertical-alignment: center;
    }
}

export struct FileRow {
    name: string,
    is-dir: bool,
    size-str: string,
    modified-str: string,
    perms: string,
}

export component FilePanel inherits Rectangle {
    in-out property <string> path;
    in property <string> title;
    in property <[FileRow]> files;
    in property <bool> connected;
    callback open-dir(string);
    callback open-file(string);
    callback refresh();
    callback up();
    callback goto(string);
    callback mkdir-requested(string);
    callback delete-requested(string);
    callback rename-requested(string, string);

    in-out property <string> selected;
    property <length> menu-x;
    property <length> menu-y;
    property <bool> menu-on-row;
    property <bool> menu-row-is-dir;
    in-out property <string> dialog-name;

    function open-row-menu(wx: length, wy: length, is-dir: bool) {
        root.menu-x = wx - root.absolute-position.x;
        root.menu-y = wy - root.absolute-position.y;
        root.menu-on-row = true;
        root.menu-row-is-dir = is-dir;
        ctx-popup.show();
    }

    function open-mkdir-dialog() {
        root.dialog-name = "";
        mkdir-popup.show();
    }

    function open-rename-dialog() {
        root.dialog-name = root.selected;
        rename-popup.show();
    }

    border-width: 1px;
    border-color: Theme.border;
    border-radius: 6px;
    background: Theme.panel;
    clip: true;

    ctx-popup := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 150px;
        Rectangle {
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 6px;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000066;
            VerticalLayout {
                padding: 4px;
                MenuItem {
                    label: "传输";
                    enabled: root.menu-on-row && !root.menu-row-is-dir;
                    clicked => {
                        ctx-popup.close();
                        root.open-file(root.selected);
                    }
                }
                MenuItem {
                    label: "删除";
                    enabled: root.menu-on-row;
                    clicked => {
                        ctx-popup.close();
                        root.delete-requested(root.selected);
                    }
                }
                MenuItem {
                    label: "重命名";
                    enabled: root.menu-on-row;
                    clicked => {
                        ctx-popup.close();
                        root.open-rename-dialog();
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }
                MenuItem {
                    label: "新建目录";
                    clicked => {
                        ctx-popup.close();
                        root.open-mkdir-dialog();
                    }
                }
                MenuItem {
                    label: "刷新";
                    clicked => {
                        ctx-popup.close();
                        root.refresh();
                    }
                }
            }
        }
    }

    mkdir-popup := PopupWindow {
        x: (root.width - 300px) / 2;
        y: 100px;
        width: 300px;
        close-policy: PopupClosePolicy.no-auto-close;
        Rectangle {
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 8px;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                Text {
                    text: "新建目录";
                    font-size: 13px;
                    color: Theme.fg;
                }
                LineEdit {
                    text <=> root.dialog-name;
                    placeholder-text: "目录名称";
                    font-size: 12px;
                    accepted(text) => {
                        root.mkdir-requested(text);
                        mkdir-popup.close();
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { }
                    Button {
                        text: "取消";
                        clicked => {
                            mkdir-popup.close();
                        }
                    }
                    Button {
                        text: "创建";
                        clicked => {
                            root.mkdir-requested(root.dialog-name);
                            mkdir-popup.close();
                        }
                    }
                }
            }
        }
    }

    rename-popup := PopupWindow {
        x: (root.width - 300px) / 2;
        y: 100px;
        width: 300px;
        close-policy: PopupClosePolicy.no-auto-close;
        Rectangle {
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 8px;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                Text {
                    text: "重命名";
                    font-size: 13px;
                    color: Theme.fg;
                }
                LineEdit {
                    text <=> root.dialog-name;
                    font-size: 12px;
                    accepted(text) => {
                        root.rename-requested(root.selected, text);
                        rename-popup.close();
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { }
                    Button {
                        text: "取消";
                        clicked => {
                            rename-popup.close();
                        }
                    }
                    Button {
                        text: "确定";
                        clicked => {
                            root.rename-requested(root.selected, root.dialog-name);
                            rename-popup.close();
                        }
                    }
                }
            }
        }
    }

    VerticalLayout {
        padding: 6px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.title;
                font-size: 12px;
                color: Theme.fg-dim;
                vertical-alignment: center;
            }
            Rectangle { }
            IconButton {
                icon: "+";
                clicked => {
                    root.open-mkdir-dialog();
                }
            }
            IconButton {
                icon: "↻";
                clicked => {
                    root.refresh();
                }
            }
            IconButton {
                icon: "↑";
                clicked => {
                    root.up();
                }
            }
        }

        LineEdit {
            text: root.path;
            placeholder-text: "输入路径后回车";
            font-size: 12px;
            accepted(text) => {
                root.goto(text);
            }
        }

        Rectangle {
            height: 22px;
            background: Theme.bg;
            border-radius: 4px;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                Text {
                    text: "名称";
                    font-size: 11px;
                    color: Theme.fg-dim;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Text {
                    text: "大小";
                    width: 90px;
                    font-size: 11px;
                    color: Theme.fg-dim;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                Text {
                    text: "修改时间";
                    width: 130px;
                    font-size: 11px;
                    color: Theme.fg-dim;
                    vertical-alignment: center;
                }
                Text {
                    text: "权限";
                    width: 100px;
                    font-size: 11px;
                    color: Theme.fg-dim;
                    vertical-alignment: center;
                }
            }
        }

        ListView {
            vertical-stretch: 1;
            for row[i] in root.files: Rectangle {
                height: 26px;
                background: root.selected == row.name ? Theme.pressed : (ta.has-hover ? Theme.hover : transparent);
                ta := TouchArea {
                    clicked => {
                        root.selected = row.name;
                    }
                    double-clicked => {
                        if (row.is-dir) {
                            root.open-dir(row.name);
                        } else {
                            root.open-file(row.name);
                        }
                    }
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                            root.selected = row.name;
                            root.open-row-menu(ta.absolute-position.x + ta.mouse-x, ta.absolute-position.y + ta.mouse-y, row.is-dir);
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;
                        Text {
                            text: row.is-dir ? "📁" : "📄";
                            width: 18px;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: row.name;
                            font-size: 12px;
                            color: Theme.fg;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: row.is-dir ? "" : row.size-str;
                        width: 90px;
                        font-size: 12px;
                        color: Theme.fg-dim;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.modified-str;
                        width: 130px;
                        font-size: 12px;
                        color: Theme.fg-dim;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Text {
                        text: row.perms;
                        width: 100px;
                        font-size: 12px;
                        color: Theme.fg-dim;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
